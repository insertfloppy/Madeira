diff --git a/FEXCore/include/FEXCore/Utils/MadeiraSmcCodeMap.h b/FEXCore/include/FEXCore/Utils/MadeiraSmcCodeMap.h
new file mode 100644
index 000000000..c6eb54782
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/MadeiraSmcCodeMap.h
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+/* MADEIRA (iOS host, ARM64EC): which bytes of a write-trapped 16 KB host page hold translated code.
+ *
+ * Every write into a write-trapped code page used to invalidate every block compiled from the whole
+ * 16 KB page, and the page's code was translated again afterwards. A JIT (HotSpot's code cache) writes
+ * new code and data next to code it already runs all the time: Project Zomboid did 658,000
+ * re-translations before its main menu. Madeira's fault handler (ntdll unix side) reads this map and
+ * completes a store itself, through a second mapping of the page, when the bytes it writes hold no
+ * translated code: nothing is invalidated and the page stays trapped.
+ *
+ * Layout is shared with C (build/ntdll-unix/virtual_ios.c, struct ios_smc_code_map); keep the two
+ * in step. A slot describes one 16 KB page; Bits has one bit per 64 bytes.
+ *   - The decoder sets the bits of an instruction BEFORE it reads the instruction's bytes, then
+ *     fences. The fault handler stores, fences, and reads the bits again: either the decoder sees
+ *     the new bytes or the handler sees the bit and sends the fault to FEX (Dekker).
+ *   - A page whose slot belongs to another page, or that was claimed outside a full-page
+ *     invalidation, has all bits set (nothing is emulated there).
+ *   - A full-page invalidation (exclusive code-invalidation lock, so no decode runs) clears the bits.
+ *   - Armed: FEX write-protected the page itself (SMC trap). Cleared on any protection change of it.
+ */
+#include <cstdint>
+
+namespace FEXCore::Madeira {
+inline constexpr uint32_t SmcCodeMapMagic = 0x31434d53; // 'SMC1'
+inline constexpr uint32_t SmcCodeMapSlots = 8192;
+inline constexpr uint64_t SmcPageSize = 0x4000;
+inline constexpr uint64_t SmcGranule = 64;
+inline constexpr uint64_t SmcArmed = 1;
+
+struct SmcCodeMapSlot {
+  uint64_t Page;
+  uint64_t Flags;
+  uint64_t Bits[4];
+};
+
+struct SmcCodeMap {
+  uint32_t Magic;
+  uint32_t SlotCount;
+  uint64_t Reserved;
+  SmcCodeMapSlot Slots[SmcCodeMapSlots];
+};
+
+// Zero-initialized (.bss, not 384 KB of the DLL file); Magic and SlotCount are set before registration.
+inline SmcCodeMap g_SmcCodeMap {};
+inline bool g_SmcCodeMapEnabled {false};
+
+inline SmcCodeMapSlot& SmcSlot(uint64_t Page) {
+  return g_SmcCodeMap.Slots[(Page / SmcPageSize) % SmcCodeMapSlots];
+}
+
+// Takes the slot for Page with every bit set (conservative) and no flags.
+inline void SmcClaim(SmcCodeMapSlot& S, uint64_t Page, uint64_t BitsValue) {
+  for (auto& W : S.Bits) {
+    __atomic_store_n(&W, BitsValue, __ATOMIC_RELAXED);
+  }
+  __atomic_store_n(&S.Flags, 0, __ATOMIC_RELAXED);
+  __atomic_store_n(&S.Page, Page, __ATOMIC_RELEASE);
+}
+
+// Decoder: about to read [Addr, Addr + Len) as code.
+inline void SmcMarkCode(uint64_t Addr, uint64_t Len) {
+  if (!g_SmcCodeMapEnabled || !Len) {
+    return;
+  }
+  const uint64_t End = Addr + Len;
+  for (uint64_t Page = Addr & ~(SmcPageSize - 1); Page < End; Page += SmcPageSize) {
+    auto& S = SmcSlot(Page);
+    if (__atomic_load_n(&S.Page, __ATOMIC_ACQUIRE) != Page) {
+      SmcClaim(S, Page, ~0ULL);
+      continue;
+    }
+    const uint64_t B = (Addr > Page ? Addr : Page) - Page;
+    const uint64_t E = (End < Page + SmcPageSize ? End : Page + SmcPageSize) - Page;
+    for (uint64_t G = B / SmcGranule; G <= (E - 1) / SmcGranule; G++) {
+      const uint64_t Bit = 1ULL << (G % 64);
+      if (!(__atomic_load_n(&S.Bits[G / 64], __ATOMIC_RELAXED) & Bit)) {
+        __atomic_fetch_or(&S.Bits[G / 64], Bit, __ATOMIC_SEQ_CST);
+      }
+    }
+  }
+  __atomic_thread_fence(__ATOMIC_SEQ_CST);
+}
+
+// Every page entirely inside [Addr, Addr + Size) lost all its translations. Caller holds the
+// code-invalidation lock exclusively.
+inline void SmcPagesInvalidated(uint64_t Addr, uint64_t Size) {
+  if (!g_SmcCodeMapEnabled) {
+    return;
+  }
+  const uint64_t Begin = (Addr + SmcPageSize - 1) & ~(SmcPageSize - 1);
+  const uint64_t End = Size > ~0ULL - Addr ? ~0ULL & ~(SmcPageSize - 1) : (Addr + Size) & ~(SmcPageSize - 1);
+  if (Begin >= End) {
+    return;
+  }
+  if ((End - Begin) / SmcPageSize > SmcCodeMapSlots) {
+    for (auto& S : g_SmcCodeMap.Slots) {
+      const uint64_t Page = __atomic_load_n(&S.Page, __ATOMIC_ACQUIRE);
+      if (Page >= Begin && Page < End) {
+        for (auto& W : S.Bits) {
+          __atomic_store_n(&W, 0, __ATOMIC_RELEASE);
+        }
+      }
+    }
+    return;
+  }
+  for (uint64_t Page = Begin; Page < End; Page += SmcPageSize) {
+    auto& S = SmcSlot(Page);
+    if (__atomic_load_n(&S.Page, __ATOMIC_ACQUIRE) != Page) {
+      SmcClaim(S, Page, 0);
+    } else {
+      for (auto& W : S.Bits) {
+        __atomic_store_n(&W, 0, __ATOMIC_RELEASE);
+      }
+    }
+  }
+}
+
+// FEX write-protected [Addr, Addr + Size) for SMC detection.
+inline void SmcSetArmed(uint64_t Addr, uint64_t Size) {
+  if (!g_SmcCodeMapEnabled || !Size) {
+    return;
+  }
+  const uint64_t End = Addr + Size;
+  for (uint64_t Page = Addr & ~(SmcPageSize - 1); Page < End; Page += SmcPageSize) {
+    auto& S = SmcSlot(Page);
+    if (__atomic_load_n(&S.Page, __ATOMIC_ACQUIRE) != Page) {
+      SmcClaim(S, Page, ~0ULL);
+    }
+    __atomic_fetch_or(&S.Flags, SmcArmed, __ATOMIC_RELEASE);
+  }
+}
+
+// The protection of [Addr, Addr + Size) changed (FEX untrapped it, or the program reprotected it).
+inline void SmcClearArmed(uint64_t Addr, uint64_t Size) {
+  if (!g_SmcCodeMapEnabled || !Size) {
+    return;
+  }
+  const uint64_t Begin = Addr & ~(SmcPageSize - 1);
+  const uint64_t End = Size > ~0ULL - Addr ? ~0ULL : Addr + Size;
+  if ((End - Begin) / SmcPageSize > SmcCodeMapSlots) {
+    for (auto& S : g_SmcCodeMap.Slots) {
+      const uint64_t Page = __atomic_load_n(&S.Page, __ATOMIC_ACQUIRE);
+      if (Page >= Begin && Page < End) {
+        __atomic_fetch_and(&S.Flags, ~SmcArmed, __ATOMIC_SEQ_CST);
+      }
+    }
+    return;
+  }
+  for (uint64_t Page = Begin; Page < End; Page += SmcPageSize) {
+    auto& S = SmcSlot(Page);
+    if (__atomic_load_n(&S.Page, __ATOMIC_ACQUIRE) == Page) {
+      __atomic_fetch_and(&S.Flags, ~SmcArmed, __ATOMIC_SEQ_CST);
+    }
+  }
+}
+} // namespace FEXCore::Madeira
