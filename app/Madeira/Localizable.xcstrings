    "Settings › Steam › Madeira Dock lists the Steam games installed in Madeira's drive_c and starts them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen › Steam › Madeira Dock listet die in Madeiras drive_c installierten Steam-Spiele auf und startet sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes › Steam › Madeira Dock muestra los juegos de Steam instalados en el drive_c de Madeira y los inicia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 › Steam › Madeira Dock은 Madeira의 drive_c에 설치된 Steam 게임을 나열하고 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes › Steam › Madeira Dock lista os jogos da Steam instalados no drive_c do Madeira e os inicia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки › Steam › Madeira Dock показывает игры Steam, установленные в drive_c Madeira, и запускает их."
          }
        }
      }
    },
