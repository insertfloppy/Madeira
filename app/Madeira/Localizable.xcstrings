    "Checks every installed file against EA's current build and downloads what is missing or changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft jede installierte Datei gegen den aktuellen Build von EA und lädt herunter, was fehlt oder sich geändert hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba cada archivo instalado con la versión actual de EA y descarga lo que falte o haya cambiado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 모든 파일을 EA의 현재 빌드와 비교하고 없거나 바뀐 파일을 다운로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confere cada arquivo instalado com a versão atual da EA e baixa o que falta ou mudou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сверяет каждый установленный файл с текущей сборкой EA и скачивает недостающее или изменённое."
          }
        }
      }
    },
