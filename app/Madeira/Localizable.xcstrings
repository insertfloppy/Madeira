          }
        }
      }
    },
    "Invert up and down": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oben und unten umkehren"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invertir arriba y abajo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상하 반전"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inverter cima e baixo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поменять верх и низ"
          }
        }
      }
    },
    "It is installed. Add it here to open it and sign in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist installiert. Füge es hier hinzu, um es zu öffnen und dich anzumelden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está instalado. Añádelo aquí para abrirlo e iniciar sesión."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치되어 있습니다. 열고 로그인하려면 여기에 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está instalado. Adicione aqui para abrir e entrar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он установлен. Добавьте его сюда, чтобы открыть и войти."
          }
        }
      }
    },
    "Items download from Steam with your account into Steam's Workshop folder beside the game, so the game finds them when it starts through Madeira Dock. Subscriptions are your Steam account's, the same as on a PC.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte werden mit deinem Konto von Steam in den Workshop-Ordner neben dem Spiel geladen, damit das Spiel sie findet, wenn es über Madeira Dock startet. Abos gehören zu deinem Steam-Konto, wie am PC."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos se descargan de Steam con tu cuenta en la carpeta Workshop de Steam junto al juego, para que el juego los encuentre al iniciarse con Madeira Dock. Las suscripciones son de tu cuenta de Steam, igual que en un PC."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목은 계정으로 Steam에서 게임 옆 Steam 창작마당 폴더에 다운로드되므로, Madeira Dock으로 시작할 때 게임이 찾을 수 있습니다. 구독은 PC에서와 마찬가지로 Steam 계정의 것입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens são baixados da Steam com sua conta para a pasta Workshop da Steam ao lado do jogo, para o jogo encontrá-los quando iniciar pelo Madeira Dock. As inscrições são da sua conta Steam, igual no PC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предметы скачиваются из Steam с вашей учётной записью в папку Мастерской Steam рядом с игрой, чтобы игра нашла их при запуске через Madeira Dock. Подписки принадлежат вашей учётной записи Steam, как на ПК."
          }
        }
      }
    },
    "Items still on this device that your account no longer subscribes to, for example ones a game downloaded for a server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte auf diesem Gerät, die dein Konto nicht mehr abonniert hat, zum Beispiel solche, die ein Spiel für einen Server geladen hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementos que siguen en este dispositivo y a los que tu cuenta ya no está suscrita, por ejemplo los que un juego descargó para un servidor."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 더 이상 구독하지 않지만 이 기기에 남아 있는 항목입니다. 예를 들어 게임이 서버용으로 다운로드한 항목입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Itens ainda neste dispositivo nos quais sua conta não está mais inscrita, por exemplo os que um jogo baixou para um servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предметы, которые ещё есть на этом устройстве, но на которые ваша учётная запись больше не подписана, например скачанные игрой для сервера."
          }
        }
      }
    },
    "Its files are deleted and the game's files it replaced are put back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Dateien werden gelöscht und die Spieldateien, die es ersetzt hat, werden wiederhergestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus archivos se borran y se restauran los archivos del juego que reemplazó."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 삭제되고 이 모드가 바꿨던 게임 파일이 원래대로 돌아옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos dele são apagados e os arquivos do jogo que ele substituiu são restaurados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его файлы удаляются, а файлы игры, которые он заменил, возвращаются."
          }
        }
      }
    },
    "Its value is set on the next page; tap the new value.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Wert wird auf der nächsten Seite festgelegt; tippe auf den neuen Wert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su valor se establece en la página siguiente; toca el valor nuevo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 다음 페이지에서 설정합니다. 새 값을 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O valor é definido na próxima página; toque no novo valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значение задаётся на следующей странице; нажмите новое значение."
          }
        }
      }
    },
