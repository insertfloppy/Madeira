    "Some Windows games are built on Microsoft's .NET Framework. Madeira runs them on Wine Mono, the Wine project's open-source .NET runtime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manche Windows-Spiele basieren auf Microsofts .NET Framework. Madeira führt sie mit Wine Mono aus, der quelloffenen .NET-Laufzeit des Wine-Projekts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos juegos de Windows se basan en .NET Framework de Microsoft. Madeira los ejecuta con Wine Mono, el runtime .NET de código abierto del proyecto Wine."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 Windows 게임은 Microsoft .NET Framework로 만들어졌습니다. Madeira는 이 게임들을 Wine 프로젝트의 오픈 소스 .NET 런타임인 Wine Mono에서 실행합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns jogos de Windows são feitos com o .NET Framework da Microsoft. O Madeira os roda no Wine Mono, o runtime .NET de código aberto do projeto Wine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые игры для Windows построены на Microsoft .NET Framework. Madeira запускает их в Wine Mono — открытой среде .NET проекта Wine."
          }
        }
      }
    },
