          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранения"
          }
        }
      }
    },
    "Search itch.io or paste a game's link, add free games to this library and install them here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuche itch.io oder füge den Link eines Spiels ein, füge kostenlose Spiele dieser Bibliothek hinzu und installiere sie hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en itch.io o pega el enlace de un juego, añade juegos gratuitos a esta biblioteca e instálalos aquí."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "itch.io를 검색하거나 게임 링크를 붙여넣어 무료 게임을 이 라이브러리에 추가하고 여기에서 설치하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise no itch.io ou cole o link de um jogo, adicione jogos grátis a esta biblioteca e instale-os aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищите на itch.io или вставьте ссылку на игру, добавляйте бесплатные игры в эту библиотеку и устанавливайте их здесь."
