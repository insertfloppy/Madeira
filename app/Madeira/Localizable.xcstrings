        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인으로 플레이하고 이 게임을 업데이트하려면 설정 › Epic Games에서 Epic Games에 로그인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre na Epic Games em Ajustes › Epic Games para jogar online e atualizar este jogo."
