            "value": "Beendet die laufende Sitzung. Nicht gespeicherter Fortschritt geht verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra la sesión en curso. Se perderá el progreso no guardado."
          }
