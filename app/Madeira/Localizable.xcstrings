    "Find on Steam": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Steam finden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar en Steam"
          }
        },
        "ko": {
          "stringUnit": {
