    "This installation can only wait about 30 seconds in the background, so go to Settings straight away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Installation kann im Hintergrund nur etwa 30 Sekunden warten, also geh sofort zu den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta instalación solo puede esperar unos 30 segundos en segundo plano, así que ve a Ajustes enseguida."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설치는 백그라운드에서 약 30초만 기다릴 수 있으니 바로 설정으로 가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta instalação só pode esperar uns 30 segundos em segundo plano, então vá aos Ajustes logo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта установка может ждать в фоне всего около 30 секунд, поэтому сразу перейдите в Настройки."
          }
        }
      }
    },
    "This is an IL2CPP Unity game. Its mods need BepInEx 6, which Madeira doesn't install yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein IL2CPP-Unity-Spiel. Seine Mods brauchen BepInEx 6, das Madeira noch nicht installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un juego Unity IL2CPP. Sus mods necesitan BepInEx 6, que Madeira aún no instala."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "IL2CPP Unity 게임입니다. 이 게임의 모드에는 BepInEx 6이 필요하며, Madeira는 아직 설치하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um jogo Unity IL2CPP. Os mods dele precisam do BepInEx 6, que o Madeira ainda não instala."
