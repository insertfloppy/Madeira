    "Copy a game's folder into Madeira › wine › drive_c with the Files app, then tap + and choose its .exe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiere den Ordner eines Spiels mit der Dateien-App nach Madeira › wine › drive_c, tippe dann auf + und wähle seine .exe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia la carpeta de un juego en Madeira › wine › drive_c con la app Archivos, luego toca + y elige su .exe."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 앱으로 게임 폴더를 Madeira › wine › drive_c에 복사한 다음 +를 탭하고 .exe를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie a pasta de um jogo para Madeira › wine › drive_c com o app Arquivos, depois toque em + e escolha o .exe."
          }
        },
        "ru": {
