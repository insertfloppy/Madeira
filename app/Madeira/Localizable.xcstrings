    "Sign in to EA in Settings › EA app to play or update this game. An EA game needs the sign-in to start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich unter Einstellungen › EA app bei EA an, um dieses Spiel zu spielen oder zu aktualisieren. Ein EA-Spiel braucht die Anmeldung zum Starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en EA en Ajustes › EA app para jugar o actualizar este juego. Un juego de EA necesita la sesión para iniciarse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임을 플레이하거나 업데이트하려면 설정 › EA 앱에서 EA에 로그인하세요. EA 게임은 시작하려면 로그인이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre na EA em Ajustes › EA app para jogar ou atualizar este jogo. Um jogo da EA precisa do login para iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Войдите в EA в Настройки › EA app, чтобы играть в эту игру или обновлять её. Игре EA для запуска нужен вход."
          }
        }
      }
    },
