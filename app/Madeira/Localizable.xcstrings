    "Send the file, or paste the text in a chat. On the other device, open the file with Madeira, or open the game's details and tap Apply Shared Setup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende die Datei oder füge den Text in einen Chat ein. Öffne die Datei auf dem anderen Gerät mit Madeira oder öffne die Spieldetails und tippe auf „Geteiltes Setup anwenden“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía el archivo o pega el texto en un chat. En el otro dispositivo, abre el archivo con Madeira, o abre los detalles del juego y toca Aplicar configuración compartida."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 보내거나 채팅에 텍스트를 붙여넣으세요. 다른 기기에서 Madeira로 파일을 열거나, 게임 정보를 열고 공유된 설정 적용을 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie o arquivo ou cole o texto num chat. No outro dispositivo, abra o arquivo com o Madeira ou abra os detalhes do jogo e toque em Aplicar configuração compartilhada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте файл или вставьте текст в чат. На другом устройстве откройте файл в Madeira или откройте сведения об игре и нажмите «Применить общую настройку»."
          }
        }
      }
    },
