    "Files that match are kept; only what differs is downloaded. Steam then starts the game on this version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übereinstimmende Dateien bleiben; nur Abweichendes wird heruntergeladen. Steam startet das Spiel dann in dieser Version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que coinciden se conservan; solo se descarga lo que difiere. Luego Steam inicia el juego en esta versión."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 파일은 유지하고 다른 부분만 다운로드합니다. 그런 다음 Steam이 이 버전으로 게임을 시작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos iguais são mantidos; só o que difere é baixado. A Steam então inicia o jogo nesta versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совпадающие файлы сохраняются; скачивается только отличающееся. Затем Steam запускает игру в этой версии."
          }
        }
      }
    },
    "Find a game": {
      "localizations": {
