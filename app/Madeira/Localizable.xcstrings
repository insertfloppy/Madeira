    "Open the login page in Safari": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldeseite in Safari öffnen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir la página de inicio de sesión en Safari"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 로그인 페이지 열기"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir a página de login no Safari"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть страницу входа в Safari"
          }
        }
      }
    },
    "Open the login page in Safari and sign in. Epic then shows a short text with \"authorizationCode\". Copy the whole text, or only the code, and paste it here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Anmeldeseite in Safari und melde dich an. Epic zeigt dann einen kurzen Text mit „authorizationCode“. Kopiere den ganzen Text oder nur den Code und füge ihn hier ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la página de inicio de sesión en Safari e inicia sesión. Epic mostrará un texto corto con «authorizationCode». Copia el texto entero, o solo el código, y pégalo aquí."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 로그인 페이지를 열고 로그인하세요. 그러면 Epic이 \"authorizationCode\"가 포함된 짧은 텍스트를 보여 줍니다. 텍스트 전체나 코드만 복사해 여기에 붙여넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a página de login no Safari e entre. A Epic então mostra um texto curto com \"authorizationCode\". Copie o texto inteiro, ou só o código, e cole aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте страницу входа в Safari и войдите. Затем Epic покажет короткий текст с «authorizationCode». Скопируйте весь текст или только код и вставьте сюда."
          }
        }
      }
    },
    "Open the login page in Safari and sign in. GOG then opens a page whose address starts with embed.gog.com/on_login_success. Copy that whole address and paste it here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Anmeldeseite in Safari und melde dich an. GOG öffnet dann eine Seite, deren Adresse mit embed.gog.com/on_login_success beginnt. Kopiere die ganze Adresse und füge sie hier ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la página de inicio de sesión en Safari e inicia sesión. GOG abrirá una página cuya dirección empieza por embed.gog.com/on_login_success. Copia la dirección completa y pégala aquí."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari에서 로그인 페이지를 열고 로그인하세요. 그러면 GOG가 embed.gog.com/on_login_success로 시작하는 주소의 페이지를 엽니다. 그 주소 전체를 복사해 여기에 붙여넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a página de login no Safari e entre. A GOG então abre uma página cujo endereço começa com embed.gog.com/on_login_success. Copie o endereço inteiro e cole aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте страницу входа в Safari и войдите. Затем GOG откроет страницу, адрес которой начинается с embed.gog.com/on_login_success. Скопируйте весь адрес и вставьте сюда."
          }
        }
      }
    },
