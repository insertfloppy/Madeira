    "Madeira Dock starts an installed Steam game through Valve's own Steam client, without the Steam desktop window. Valve's client signs in with your account and decides whether the game may run.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock startet ein installiertes Steam-Spiel über Valves eigenen Steam-Client, ohne das Steam-Desktopfenster. Valves Client meldet sich mit deinem Konto an und entscheidet, ob das Spiel laufen darf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock inicia un juego de Steam instalado a través del propio cliente de Steam de Valve, sin la ventana de escritorio de Steam. El cliente de Valve inicia sesión con tu cuenta y decide si el juego puede ejecutarse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock은 설치된 Steam 게임을 Steam 데스크톱 창 없이 Valve의 Steam 클라이언트로 시작합니다. Valve 클라이언트가 계정으로 로그인하고 게임 실행 여부를 결정합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira Dock inicia um jogo da Steam instalado pelo próprio cliente Steam da Valve, sem a janela de área de trabalho da Steam. O cliente da Valve entra com sua conta e decide se o jogo pode rodar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock запускает установленную игру Steam через собственный клиент Steam от Valve, без окна Steam. Клиент Valve входит с вашей учётной записью и решает, может ли игра запуститься."
          }
        }
      }
    },
    "Madeira Dock starts your installed Steam games through Valve's own Steam client, without the Steam desktop window. It needs the client's components, which Madeira downloads from Valve.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock startet deine installierten Steam-Spiele über Valves eigenen Steam-Client, ohne das Steam-Desktopfenster. Dafür braucht es die Komponenten des Clients, die Madeira von Valve lädt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock inicia tus juegos de Steam instalados a través del propio cliente de Steam de Valve, sin la ventana de escritorio de Steam. Necesita los componentes del cliente, que Madeira descarga de Valve."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock은 설치된 Steam 게임을 Steam 데스크톱 창 없이 Valve의 Steam 클라이언트로 시작합니다. 클라이언트 구성 요소가 필요하며, Madeira가 Valve에서 다운로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira Dock inicia seus jogos da Steam instalados pelo próprio cliente Steam da Valve, sem a janela de área de trabalho da Steam. Ele precisa dos componentes do cliente, que o Madeira baixa da Valve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock запускает ваши установленные игры Steam через собственный клиент Steam от Valve, без окна Steam. Ему нужны компоненты клиента, которые Madeira скачивает у Valve."
          }
        }
      }
    },
    "Madeira Dock stopped": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock wurde beendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock se detuvo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock이 멈췄습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira Dock parou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira Dock остановлен"
          }
        }
      }
    },
    "Madeira downloads it from WineHQ: about 42 MB, about 130 MB once installed. Most games do not need it; you can also add it later in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira lädt es von WineHQ: etwa 42 MB, installiert etwa 130 MB. Die meisten Spiele brauchen es nicht; du kannst es auch später in den Einstellungen hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira lo descarga de WineHQ: unos 42 MB, unos 130 MB instalado. La mayoría de juegos no lo necesitan; también puedes añadirlo después en Ajustes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira가 WineHQ에서 다운로드합니다: 약 42MB, 설치 후 약 130MB. 대부분의 게임에는 필요 없으며, 나중에 설정에서 추가할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira o baixa do WineHQ: cerca de 42 MB, cerca de 130 MB instalado. A maioria dos jogos não precisa; você também pode adicioná-lo depois em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira скачивает его с WineHQ: около 42 МБ, около 130 МБ после установки. Большинству игр он не нужен; можно добавить его позже в Настройках."
          }
        }
      }
    },
    "Madeira forgets this drive and removes its games from the library. The files on the drive are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira vergisst dieses Laufwerk und entfernt seine Spiele aus der Bibliothek. Die Dateien auf dem Laufwerk bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira olvida esta unidad y quita sus juegos de la biblioteca. Los archivos de la unidad se conservan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira가 이 드라이브를 잊고 그 게임들을 라이브러리에서 제거합니다. 드라이브의 파일은 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira esquece esta unidade e remove os jogos dela da biblioteca. Os arquivos na unidade são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira забудет этот диск и уберёт его игры из библиотеки. Файлы на диске останутся."
          }
        }
      }
    },
    "Madeira is a proof-of-concept for running x86 Windows games on iOS using FEX-Emu, Wine, and Metal-based graphics translation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira ist ein Machbarkeitsnachweis, um x86-Windows-Spiele auf iOS mit FEX-Emu, Wine und Metal-basierter Grafikübersetzung auszuführen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira es una prueba de concepto para ejecutar juegos x86 de Windows en iOS con FEX-Emu, Wine y traducción de gráficos basada en Metal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira는 FEX-Emu, Wine, Metal 기반 그래픽 변환으로 iOS에서 x86 Windows 게임을 실행하는 개념 증명입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira é uma prova de conceito para rodar jogos x86 de Windows no iOS usando FEX-Emu, Wine e tradução de gráficos baseada em Metal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira — это проверка концепции: запуск x86-игр Windows на iOS с помощью FEX-Emu, Wine и трансляции графики на Metal."
          }
        }
      }
    },
    "Madeira is built on Wine, FEX-Emu, DXMT by Feifan He (3Shain) with the Direct3D 9 frontend by David Acevedo (dacevedo12), rpmalloc by Mattias Jansson, StikDebug, StikJIT and idevice. Thank you to everyone who contributes to these projects.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira basiert auf Wine, FEX-Emu, DXMT von Feifan He (3Shain) mit dem Direct3D-9-Frontend von David Acevedo (dacevedo12), rpmalloc von Mattias Jansson, StikDebug, StikJIT und idevice. Danke an alle, die zu diesen Projekten beitragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira se basa en Wine, FEX-Emu, DXMT de Feifan He (3Shain) con el frontend de Direct3D 9 de David Acevedo (dacevedo12), rpmalloc de Mattias Jansson, StikDebug, StikJIT e idevice. Gracias a todos los que contribuyen a estos proyectos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira는 Wine, FEX-Emu, Feifan He(3Shain)의 DXMT와 David Acevedo(dacevedo12)의 Direct3D 9 프런트엔드, Mattias Jansson의 rpmalloc, StikDebug, StikJIT, idevice를 바탕으로 만들어졌습니다. 이 프로젝트들에 기여하는 모든 분께 감사드립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira é feito com Wine, FEX-Emu, DXMT de Feifan He (3Shain) com o frontend de Direct3D 9 de David Acevedo (dacevedo12), rpmalloc de Mattias Jansson, StikDebug, StikJIT e idevice. Obrigado a todos que contribuem para esses projetos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira построена на Wine, FEX-Emu, DXMT от Feifan He (3Shain) с фронтендом Direct3D 9 от David Acevedo (dacevedo12), rpmalloc от Mattias Jansson, StikDebug, StikJIT и idevice. Спасибо всем, кто вносит вклад в эти проекты."
          }
        }
      }
    },
    "Madeira keeps a GOG sign-in token in this device's Keychain, for this device only. Signing out removes it; installed games stay and still play.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira speichert ein GOG-Anmeldetoken im Schlüsselbund dieses Geräts, nur für dieses Gerät. Abmelden entfernt es; installierte Spiele bleiben und laufen weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira guarda un token de inicio de sesión de GOG en el llavero de este dispositivo, solo para este dispositivo. Cerrar sesión lo elimina; los juegos instalados se quedan y siguen funcionando."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira는 GOG 로그인 토큰을 이 기기의 키체인에 이 기기 전용으로 보관합니다. 로그아웃하면 제거되며, 설치된 게임은 남아 있고 계속 플레이할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira guarda um token de login da GOG nas Chaves deste dispositivo, só para este dispositivo. Sair o remove; os jogos instalados ficam e continuam rodando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira хранит токен входа GOG в Связке ключей этого устройства, только для этого устройства. Выход удаляет его; установленные игры остаются и продолжают работать."
          }
        }
      }
    },
    "Madeira keeps an EA sign-in token in this device's Keychain, for this device only. Signing out removes it; installed games stay, but need the sign-in to start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira speichert ein EA-Anmeldetoken im Schlüsselbund dieses Geräts, nur für dieses Gerät. Abmelden entfernt es; installierte Spiele bleiben, brauchen aber die Anmeldung zum Starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira guarda un token de inicio de sesión de EA en el llavero de este dispositivo, solo para este dispositivo. Cerrar sesión lo elimina; los juegos instalados se quedan, pero necesitan la sesión para iniciarse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira는 EA 로그인 토큰을 이 기기의 키체인에 이 기기 전용으로 보관합니다. 로그아웃하면 제거되며, 설치된 게임은 남지만 시작하려면 로그인이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira guarda um token de login da EA nas Chaves deste dispositivo, só para este dispositivo. Sair o remove; os jogos instalados ficam, mas precisam do login para iniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira хранит токен входа EA в Связке ключей этого устройства, только для этого устройства. Выход удаляет его; установленные игры остаются, но для запуска им нужен вход."
          }
        }
      }
    },
    "Madeira keeps an Epic Games sign-in token in this device's Keychain, for this device only. Signing out removes it; installed games stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira speichert ein Epic-Games-Anmeldetoken im Schlüsselbund dieses Geräts, nur für dieses Gerät. Abmelden entfernt es; installierte Spiele bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira guarda un token de inicio de sesión de Epic Games en el llavero de este dispositivo, solo para este dispositivo. Cerrar sesión lo elimina; los juegos instalados se quedan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira는 Epic Games 로그인 토큰을 이 기기의 키체인에 이 기기 전용으로 보관합니다. 로그아웃하면 제거되며, 설치된 게임은 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira guarda um token de login da Epic Games nas Chaves deste dispositivo, só para este dispositivo. Sair o remove; os jogos instalados ficam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira хранит токен входа Epic Games в Связке ключей этого устройства, только для этого устройства. Выход удаляет его; установленные игры остаются."
          }
        }
      }
    },
    "Madeira puts a copy of this program in place of the one Steam starts (the launcher is kept, and goes back with Steam's choice). Steam still starts the game and checks ownership.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira legt eine Kopie dieses Programms an die Stelle des Programms, das Steam startet (der Launcher bleibt erhalten und kehrt mit Steams Auswahl zurück). Steam startet das Spiel weiterhin und prüft den Besitz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira pone una copia de este programa en lugar del que inicia Steam (el launcher se conserva y vuelve con la opción de Steam). Steam sigue iniciando el juego y comprobando la propiedad."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira는 Steam이 시작하는 프로그램 자리에 이 프로그램의 사본을 둡니다(런처는 보관되며 Steam의 선택으로 되돌리면 돌아갑니다). 게임 시작과 소유권 확인은 여전히 Steam이 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira coloca uma cópia deste programa no lugar do que a Steam inicia (o launcher é mantido e volta com a opção da Steam). A Steam continua iniciando o jogo e verificando a posse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira ставит копию этой программы на место той, что запускает Steam (лаунчер сохраняется и вернётся вместе с выбором Steam). Steam по-прежнему запускает игру и проверяет владение."
          }
        }
      }
    },
    "Madeira signs in with an API key you make on itch.io, kept in this device's Keychain for this device only. Signing out removes it; installed games stay and still play. You can also delete the key on itch.io at any time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira meldet sich mit einem API-Schlüssel an, den du auf itch.io erstellst, gespeichert im Schlüsselbund dieses Geräts nur für dieses Gerät. Abmelden entfernt ihn; installierte Spiele bleiben und laufen weiter. Du kannst den Schlüssel auch jederzeit auf itch.io löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira inicia sesión con una clave API que creas en itch.io, guardada en el llavero de este dispositivo solo para este dispositivo. Cerrar sesión la elimina; los juegos instalados se quedan y siguen funcionando. También puedes borrar la clave en itch.io en cualquier momento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira는 itch.io에서 만든 API 키로 로그인하며, 키는 이 기기의 키체인에 이 기기 전용으로 보관됩니다. 로그아웃하면 제거되며, 설치된 게임은 남아 있고 계속 플레이할 수 있습니다. itch.io에서 언제든 키를 삭제할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira entra com uma chave de API que você cria no itch.io, guardada nas Chaves deste dispositivo só para este dispositivo. Sair a remove; os jogos instalados ficam e continuam rodando. Você também pode apagar a chave no itch.io quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira входит с API-ключом, который вы создаёте на itch.io; он хранится в Связке ключей этого устройства только для этого устройства. Выход удаляет его; установленные игры остаются и продолжают работать. Ключ также можно удалить на itch.io в любое время."
          }
        }
      }
    },
    "Madeira starts the game the way the EA app would: it fetches the game's licence for your account, and stands in for the EA app's local service while the game runs. There is no EA app in Madeira, so friends, the overlay and cloud saves are not available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira startet das Spiel so, wie es die EA app tun würde: Es holt die Lizenz des Spiels für dein Konto und vertritt den lokalen Dienst der EA app, während das Spiel läuft. In Madeira gibt es keine EA app, daher sind Freunde, das Overlay und Cloud-Spielstände nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira inicia el juego como lo haría la EA app: obtiene la licencia del juego para tu cuenta y sustituye al servicio local de la EA app mientras el juego se ejecuta. No hay EA app en Madeira, así que amigos, la superposición y las partidas en la nube no están disponibles."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira는 EA 앱과 같은 방식으로 게임을 시작합니다. 계정의 게임 라이선스를 가져오고, 게임이 실행되는 동안 EA 앱의 로컬 서비스 역할을 대신합니다. Madeira에는 EA 앱이 없으므로 친구, 오버레이, 클라우드 저장은 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Madeira inicia o jogo como o EA app faria: busca a licença do jogo para sua conta e substitui o serviço local do EA app enquanto o jogo roda. Não existe EA app no Madeira, então amigos, a sobreposição e os saves na nuvem não estão disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Madeira запускает игру так же, как EA app: получает лицензию игры для вашей учётной записи и подменяет локальную службу EA app, пока идёт игра. EA app в Madeira нет, поэтому друзья, оверлей и облачные сохранения недоступны."
          }
        }
      }
    },
    "Make yourself at home": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fühl dich wie zu Hause"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponte cómodo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편하게 시작하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique à vontade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будьте как дома"
          }
        }
      }
    },
    "Memory & sync": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher & Sync"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Memoria y sincronización"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모리 및 동기화"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Memória e sincronização"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память и синхронизация"
          }
        }
      }
    },
    "MetalFX renders at the resolution above and upscales it (Direct3D 11 and 12).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX rendert in der Auflösung oben und skaliert hoch (Direct3D 11 und 12)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX renderiza a la resolución de arriba y la reescala (Direct3D 11 y 12)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MetalFX는 위의 해상도로 렌더링한 뒤 업스케일합니다(Direct3D 11 및 12)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O MetalFX renderiza na resolução acima e faz o upscale (Direct3D 11 e 12)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
