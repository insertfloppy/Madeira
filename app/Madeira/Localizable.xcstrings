          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de jugar, conecta [LocalDevVPN](https://apps.apple.com/us/app/localdevvpn/id6755608044). Madeira activa JIT a través de él."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이하기 전에 [LocalDevVPN](https://apps.apple.com/us/app/localdevvpn/id6755608044)에 연결하세요. Madeira는 이를 통해 JIT를 켭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de jogar, conecte o [LocalDevVPN](https://apps.apple.com/us/app/localdevvpn/id6755608044). O Madeira ativa o JIT por meio dele."
          }
        },
        "ru": {
