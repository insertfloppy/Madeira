    "Automatic uses StikDebug when it is installed. Madeira does not silently change methods after a failure.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch verwendet StikDebug, wenn es installiert ist. Madeira wechselt die Methode nach einem Fehler nicht stillschweigend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa StikDebug cuando está instalado. Madeira no cambia de método en silencio tras un fallo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 StikDebug가 설치되어 있으면 그것을 사용합니다. Madeira는 실패한 뒤에 몰래 방식을 바꾸지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa o StikDebug quando ele está instalado. O Madeira não troca de método em silêncio após uma falha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически использует StikDebug, если он установлен. После сбоя Madeira не меняет способ втихую."
          }
        }
      }
    },
