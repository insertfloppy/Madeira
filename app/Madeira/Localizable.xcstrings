        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 세션을 닫습니다. 저장하지 않은 진행 상황은 사라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra a sessão atual. O progresso não salvo será perdido."
